# ==============================================================================
# ResearchForge - Root Environment Variables Template
# Copy this file to each service's respective .env or configure per service.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database & Infrastructure (Shared)
# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection String (with pgvector support)
DATABASE_URL=postgresql://username:password@ep-sample-pool.neon.tech/researchforge?sslmode=require

# Redis Connection URL (caching and temporary coordination)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Node.js Backend (Express.js)
# ------------------------------------------------------------------------------
PORT_NODE_SERVER=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AI_ENGINE_URL=http://localhost:8000

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:5000

# GitHub OAuth
GITHUB_CLIENT_ID=your_actual_client_id
GITHUB_CLIENT_SECRET=your_actual_client_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_actual_google_client_id
GOOGLE_CLIENT_SECRET=your_actual_google_client_secret

TAVILY_API_KEY=your_tavily_api
EXA_API_KEY=your_exa_api
FIRECRAWL_API_KEY=your_firecrawl_api

# ------------------------------------------------------------------------------
# AI Engine Backend (FastAPI & LangGraph)
# ------------------------------------------------------------------------------
PORT_AI_ENGINE=8000
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_ENV=development
NODE_BACKEND_URL=http://localhost:5000

# AI Models & Provider Keys
# Groq API Key (for openai/gpt-oss-120b and openai/gpt-oss-20b)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Token (for BAAI/bge-small-en-v1.5 embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Remote MCP Server Endpoints (JSON or comma-separated configurations)
REMOTE_MCP_SERVERS={"academic_search":"https://mcp.example.com/academic","web_retrieval":"https://mcp.example.com/web"}

