# ResearchForge - AI Engine Environment Variables
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Neon PostgreSQL Database URL (Read/Write via lightweight data access layer)
# Migrations are managed exclusively by the Node.js backend
DATABASE_URL=postgresql://username:password@ep-sample-pool.neon.tech/researchforge?sslmode=require

# Redis Cache URL
REDIS_URL=redis://localhost:6379

# Inter-Service Communication
NODE_BACKEND_URL=http://localhost:5000

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_REASONING_MODEL=openai/gpt-oss-120b
LIGHTWEIGHT_TASK_MODEL=openai/gpt-oss-20b

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Remote MCP Servers Configuration
# JSON-formatted dictionary of remote MCP endpoints to connect as client
REMOTE_MCP_SERVERS={"academic_search":"https://mcp.example.com/academic"}

