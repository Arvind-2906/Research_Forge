# ResearchForge - Node.js Backend Environment Variables
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database URL (Prisma connection)
DATABASE_URL=postgresql://username:password@ep-sample-pool.neon.tech/researchforge?sslmode=require

# Service URLs
FRONTEND_URL=http://localhost:3000
AI_ENGINE_URL=http://localhost:8000

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:5000

# Redis Cache
REDIS_URL=redis://localhost:6379

